generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PRODUCT_MANAGER
  VIEWER
}

enum PlanType {
  CURRENT
  PROPOSED
}

enum ScenarioStatus {
  DRAFT
  RUN
  ARCHIVED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  customers Customer[]
  plans     Plan[]
  features  Feature[]
  scenarios SimulationScenario[]
  imports   ImportBatch[]
  riskWeights RiskWeightSetting?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(PRODUCT_MANAGER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenarios      SimulationScenario[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Customer {
  id                                String   @id @default(cuid())
  organizationId                    String
  organization                      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalCustomerId                String
  companyName                       String
  segment                           String
  region                            String
  currentPlanId                     String?
  currentPlan                       Plan?    @relation(fields: [currentPlanId], references: [id], onDelete: SetNull)
  mrr                               Decimal  @db.Decimal(12, 2)
  arr                               Decimal  @db.Decimal(12, 2)
  renewalDate                       DateTime
  contractType                      String
  customerSuccessOwner              String
  healthScore                       Int
  supportTicketCountLast90Days      Int
  featureUsage                      FeatureUsage[]
  contract                          Contract?
  impacts                           CustomerImpact[]
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  @@unique([organizationId, externalCustomerId])
  @@index([organizationId, segment])
  @@index([organizationId, renewalDate])
}

model Plan {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planType       PlanType
  name           String
  monthlyPrice   Decimal  @db.Decimal(12, 2)
  annualPrice    Decimal  @db.Decimal(12, 2)
  usageLimits    Json
  supportLevel   String
  features       PlanFeature[]
  customers      Customer[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, planType, name])
}

model Feature {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key                String
  name               String
  description        String
  category           String
  isBusinessCritical Boolean  @default(false)
  plans              PlanFeature[]
  usage              FeatureUsage[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([organizationId, key])
}

model PlanFeature {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([planId, featureId])
}

model FeatureUsage {
  id                       String   @id @default(cuid())
  customerId               String
  customer                 Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  featureId                String
  feature                  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  usageCountLast30Days     Int
  usageCountLast90Days     Int
  isBusinessCritical       Boolean
  createdAt                DateTime @default(now())

  @@unique([customerId, featureId])
}

model Contract {
  id                         String   @id @default(cuid())
  customerId                 String   @unique
  customer                   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  renewalDate                DateTime
  contractEndDate            DateTime
  discountPercentage         Decimal  @db.Decimal(5, 2)
  customTerms                String
  canChangePriceBeforeRenewal Boolean
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model SimulationScenario {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  description         String
  pricingChangeType   String
  affectedPlanIds     String[]
  proposedPlanIds     String[]
  affectedFeatureIds  String[]
  migrationStartDate  DateTime
  migrationEndDate    DateTime
  grandfatheringRule  String
  revenueAssumption   String
  churnRiskAssumption String
  discountStrategy    String
  notes               String
  status              ScenarioStatus @default(DRAFT)
  createdById         String
  createdBy           User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  result              SimulationResult?
  strategies          StrategyComparison[]
  reports             Report[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SimulationResult {
  id                     String   @id @default(cuid())
  scenarioId             String   @unique
  scenario               SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  currentArr             Decimal  @db.Decimal(14, 2)
  proposedArr            Decimal  @db.Decimal(14, 2)
  arrDelta               Decimal  @db.Decimal(14, 2)
  estimatedRevenueUplift Decimal  @db.Decimal(14, 2)
  revenueAtRisk          Decimal  @db.Decimal(14, 2)
  affectedCustomersCount Int
  highRiskCustomersCount Int
  migrationReadinessScore Int
  recommendation         String
  impacts                CustomerImpact[]
  createdAt              DateTime @default(now())
}

model CustomerImpact {
  id                               String   @id @default(cuid())
  simulationResultId               String
  simulationResult                 SimulationResult @relation(fields: [simulationResultId], references: [id], onDelete: Cascade)
  customerId                       String
  customer                         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  featureLossCount                 Int
  businessCriticalFeatureLossCount Int
  monthlyPriceDelta                Decimal  @db.Decimal(12, 2)
  annualPriceDelta                 Decimal  @db.Decimal(12, 2)
  churnRiskScore                   Int
  migrationDifficultyScore         Int
  revenueImpactScore               Int
  overallImpactScore               Int
  recommendedAction                String
  explanation                      String
  createdAt                        DateTime @default(now())
}

model StrategyComparison {
  id                         String   @id @default(cuid())
  scenarioId                 String
  scenario                   SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  strategyName               String
  estimatedArr               Decimal  @db.Decimal(14, 2)
  arrUplift                  Decimal  @db.Decimal(14, 2)
  revenueAtRisk              Decimal  @db.Decimal(14, 2)
  affectedCustomersCount     Int
  highRiskCustomersCount     Int
  grandfatheredCustomersCount Int
  executionComplexity        Int
  recommendedScore           Int
  createdAt                  DateTime @default(now())
}

model ImportBatch {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  filename       String
  status         String
  totalRows      Int
  successfulRows Int
  failedRows     Int
  errors         ImportError[]
  createdAt      DateTime @default(now())
}

model ImportError {
  id            String   @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber     Int
  field         String
  message       String
  rawData       Json
  createdAt     DateTime @default(now())
}

model RiskWeightSetting {
  id                            String   @id @default(cuid())
  organizationId                String   @unique
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  healthScoreWeight             Int      @default(15)
  supportTicketsWeight          Int      @default(10)
  featureLossWeight             Int      @default(12)
  businessCriticalFeatureWeight Int      @default(18)
  priceIncreaseWeight           Int      @default(12)
  renewalProximityWeight        Int      @default(10)
  contractRestrictionWeight     Int      @default(8)
  enterpriseSegmentWeight       Int      @default(6)
  arrImpactWeight               Int      @default(5)
  featureUsageWeight            Int      @default(4)
  updatedAt                     DateTime @updatedAt
}

model Report {
  id              String   @id @default(cuid())
  scenarioId      String
  scenario        SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  title           String
  markdownContent String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
